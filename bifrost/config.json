  "governance": {
    "routing_rules": [
      {
        "id": "coire-vision",
        "name": "coire-vision",
        "enabled": true,
        "cel_expression": "model == \"coire-vision\"",
        "targets": [
          {
            "provider": "gemini",
            "model": "gemini-3.5-flash",
            "weight": 1
          }
        ],
        "fallbacks": [
          "cerebras/gemma-4-31b",
          "gemini/gemini-2.5-flash",
          "gemini/gemini-2.5-flash-lite",
          "kilo/stepfun/step-3.7-flash:free",
          "cohere/command-a-vision-07-2025",
          "nvidia-nim/meta/llama-3.2-90b-vision-instruct",
          "ionet/meta-llama/Llama-3.2-90B-Vision-Instruct",
          "openrouter/nvidia/nemotron-nano-12b-v2-vl:free",
          "zai/glm-4.6v-flash",
          "reka/reka-edge-2603"
        ],
        "scope": "global",
        "priority": 20
      },
      {
        "id": "coire-fast",
        "name": "coire-fast",
        "enabled": true,
        "cel_expression": "model == \"coire-fast\"",
        "targets": [
