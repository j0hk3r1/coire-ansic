{
  "$schema": "https://www.getbifrost.ai/schema",
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "./config.db"
    }
  },
  "providers": {
    "cerebras": {
      "keys": [
        {
          "name": "cerebras-1",
          "value": "env.CEREBRAS_API_KEY",
          "models": [
            "*"
          ],
          "weight": 1
        }
      ],
      "network_config": {
        "max_retries": 2,
        "retry_backoff_initial": 500,
        "retry_backoff_max": 5000
      }
    },
    "cloudflare": {
      "keys": [
        {
          "name": "cf-1",
          "value": "env.CLOUDFLARE_API_KEY",
          "models": [
            "*"
          ],
          "weight": 1
        }
      ],
      "network_config": {
        "base_url": "https://api.cloudflare.com/client/v4/accounts/${CLOUDFLARE_ACCOUNT_ID}/ai/v1",
        "default_request_timeout_in_seconds": 90,
        "max_retries": 2,
        "retry_backoff_initial": 500,
        "retry_backoff_max": 5000
      },
      "custom_provider_config": {
        "is_key_less": false,
        "base_provider_type": "openai",
        "allowed_requests": {
          "chat_completion": true,
          "chat_completion_stream": true
        },
        "request_path_overrides": {
          "chat_completion": "https://api.cloudflare.com/client/v4/accounts/${CLOUDFLARE_ACCOUNT_ID}/ai/v1/chat/completions",
          "chat_completion_stream": "https://api.cloudflare.com/client/v4/accounts/${CLOUDFLARE_ACCOUNT_ID}/ai/v1/chat/completions"
        }
      }
    },
    "cohere": {
      "keys": [
        {
          "name": "cohere-1",
          "value": "env.COHERE_API_KEY",
          "models": [
            "*"
          ],
          "weight": 1
        }
      ],
      "network_config": {
        "max_retries": 2,
        "retry_backoff_initial": 500,
        "retry_backoff_max": 5000
      }
    },
    "gemini": {
      "keys": [
        {
          "name": "gemini-1",
          "value": "env.GEMINI_API_KEY",
          "models": [
            "*"
          ],
          "weight": 1
        }
      ],
      "network_config": {
        "max_retries": 2,
        "retry_backoff_initial": 500,
        "retry_backoff_max": 5000
      }
    },
    "github-models": {
      "keys": [
        {
          "name": "gh-1",
          "value": "env.GITHUB_MODELS_TOKEN",
          "models": [
            "*"
          ],
          "weight": 1
        }
      ],
      "network_config": {
        "base_url": "https://models.github.ai/inference",
        "default_request_timeout_in_seconds": 120,
