# coire-ansic — single source of truth for credentials.
# Copy to .env and fill in. Both Bifrost (docker) and the host scripts read this.

# ─── Bifrost auth (master key clients use to talk to Bifrost) ─────────────
BIFROST_API_KEY=sk-CHANGE-ME-32-random-bytes
# Bifrost admin password (admin UI + dashboard + apply_snapshot.py). Auto-
# generated by install.sh if left blank.
BIFROST_PASS=

# ─── LLM provider keys (free tiers — only fill the ones you have) ─────────
# Cerebras: 5 RPM, 2400 RPD/model, 30k TPM. Sign up: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Cloudflare Workers AI: 10k neurons/day pooled across all CF models.
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# Google AI Studio (Gemini): 20 RPM per model, 250 RPD per flash model.
GEMINI_API_KEY=
# Mistral: 4 RPM large / 50 RPM medium, generous TPM.
MISTRAL_API_KEY=
# NVIDIA NIM: ~1000 monthly credits dev preview. Sign up: https://build.nvidia.com
NVIDIA_API_KEY=
# OpenRouter: 50 RPD pooled across :free tier models.
OPENROUTER_API_KEY=
# Groq: 1000 RPD, 12k TPM. Sign up: https://console.groq.com
GROQ_API_KEY=
# SambaNova: 20 RPD per model, 32k ctx. Sign up: https://cloud.sambanova.ai
SAMBANOVA_API_KEY=
# GitHub Models: 20k RPM, 8k ctx. Fine-grained PAT with "models" scope.
GITHUB_MODELS_TOKEN=
# Cohere: 20 RPM trial, 1000 calls/month.
COHERE_API_KEY=
# OpenCode Zen: paid-tier preview, ~5-10 calls/day on demo tier.
OPENCODE_ZEN_API_KEY=
# Z.ai (Zhipu): native GLM models, tight per-model RPM. Free models include
# glm-4.7-flash, glm-4.5-flash. Get key at https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=

# ─── Local services (don't change unless you know why) ────────────────────
SEARXNG_URL=http://localhost:8891
SEARXNG_SECRET=change-me-random-string
# Camofox (anti-detect Firefox) — host port 9378 → container 9377.
# CAMOFOX_API_KEY auto-generated by install.sh --with-camofox if blank.
CAMOFOX_URL=http://localhost:9378
CAMOFOX_API_KEY=
CAMOFOX_AUTH_MODE=auto

# ─── Firecrawl self-hosted (free local web_extract backend) ───────────────
FIRECRAWL_API_URL=http://172.17.0.1:3002
FIRECRAWL_API_KEY=local-no-auth
