# Hermes Free Cloud — single source of truth for credentials.
# Copy to .env and fill in. Both Bifrost (docker) and Hermes (host) read this.

# ─── Bifrost auth (master key clients use to talk to Bifrost) ─────────────
BIFROST_API_KEY=sk-CHANGE-ME-32-random-bytes
# Bifrost admin password (admin UI + dashboard + apply_snapshot.py). Auto-
# generated by install.sh if left blank.
BIFROST_PASS=

# ─── LLM provider keys (free tiers — only fill the ones you have) ─────────
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# ─── Added 2026-05 — verified working free tiers ──────────────────────────
# SambaNova: 20 RPD on free tier, DeepSeek-V3.1/V3.2 hosted.
SAMBANOVA_API_KEY=
# GitHub Models: per-PAT rate limits (~20k RPM / 2M TPM), generous.
# Use a fine-grained PAT with the "models" scope.
GITHUB_MODELS_TOKEN=
# Cohere: trial tier, 20 RPM, command-a 288k ctx + command-r series.
COHERE_API_KEY=

# ─── Telegram (BotFather) ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_HOME_CHANNEL=

# ─── GitHub PAT (read-only public repo, for github MCP) ───────────────────
GITHUB_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=

# ─── Artificial Analysis (free 1k req/day) ────────────────────────────────
AA_API_KEY=

# ─── Local services (don't change unless you know why) ────────────────────
SEARXNG_URL=http://localhost:8891
CAMOFOX_URL=http://localhost:9378
SEARXNG_SECRET=change-me-random-string

# ─── Firecrawl self-hosted (free local web_extract backend) ───────────────
# Set up via scripts/install_firecrawl.sh. Hermes-agent's existing firecrawl
# backend just needs the URL pointing at the local stack.
FIRECRAWL_API_URL=http://172.17.0.1:3002
FIRECRAWL_API_KEY=local-no-auth
