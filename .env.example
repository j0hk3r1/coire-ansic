# coire-ansic — single source of truth for credentials.
# Copy to .env and fill in. Bifrost reads this via docker-compose env_file;
# bifrost/config.json references these as `env.<NAME>` (secrets never live in
# the committed config).

# ─── Bifrost auth ─────────────────────────────────────────────────────────
# Admin password — guards the management API + dashboard. Auto-generated by
# install.sh if left blank.
BIFROST_PASS=
# OPTIONAL. Client inference is UNAUTHENTICATED by default (trusted-LAN deploy).
# Leave blank unless you expose the router beyond a trusted network — then set a
# bifrost virtual key (sk-bf-*) AND enable client.enforce_auth_on_inference in
# bifrost/config.json. Not required for a normal LAN install.
BIFROST_API_KEY=

# ─── LLM provider keys (free tiers — only fill the ones you have) ─────────
# Cerebras: 5 RPM, 2400 RPD/model, 30k TPM. Sign up: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Cloudflare Workers AI: 10k neurons/day pooled across all CF models.
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# Google AI Studio (Gemini): 20 RPM per model, 250 RPD per flash model.
GEMINI_API_KEY=
# Mistral: 4 RPM large / 50 RPM medium, generous TPM.
MISTRAL_API_KEY=
# NVIDIA NIM: ~1000 monthly credits dev preview. Sign up: https://build.nvidia.com
NVIDIA_API_KEY=
# OpenRouter: 50 RPD pooled across :free tier models.
OPENROUTER_API_KEY=
# Groq: 1000 RPD, 12k TPM. Sign up: https://console.groq.com
GROQ_API_KEY=
# SambaNova: 20 RPD per model, 32k ctx. Sign up: https://cloud.sambanova.ai
SAMBANOVA_API_KEY=
# GitHub Models: 20k RPM, 8k ctx. Fine-grained PAT with "models" scope.
GITHUB_MODELS_TOKEN=
# Cohere: 20 RPM trial, 1000 calls/month.
COHERE_API_KEY=
# OpenCode Zen: paid-tier preview, ~5-10 calls/day on demo tier.
OPENCODE_ZEN_API_KEY=
# Z.ai (Zhipu): native GLM models, tight per-model RPM. Free models include
# glm-4.7-flash, glm-4.5-flash, glm-4.6v-flash (vision). Get key at
# https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=

# Kilo Gateway (kilo.ai) needs NO key — anonymous free tier, ~200 req/hr per IP
# on :free models (incl. nemotron-3-ultra-550b). Wired in automatically.
# OPTIONAL: an account key ties the quota to your account instead of your IP.
KILO_API_KEY=

# io.net Intelligence: recurring free daily per-model quota. https://io.net
IONET_API_KEY=
# Reka: $10 free credits every month (recurring). https://platform.reka.ai
REKA_API_KEY=

# Auxiliary services (searxng, camofox, firecrawl) are NOT part of this router —
# they run from their own deploys (the shitbox homelab repo). Keep their keys there.
