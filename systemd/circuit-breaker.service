[Unit]
Description=Bifrost pool circuit breaker
After=network-online.target

[Service]
Type=simple
Environment=CB_WINDOW_SEC=1800
Environment=CB_RATELIMIT_TRIP=3
Environment=CB_TIMEOUT_TRIP=2
Environment=CB_MIN_CALLS=3
Environment=CB_FAIL_RATE=0.6
Environment=CB_POLL_SEC=30
Environment=CB_RESTORE_GRACE_SEC=300
ExecStart=/usr/bin/python3 __HFC_ROOT__/scripts/runtime/circuit_breaker.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
