#!/usr/bin/env bash
# Append one audit line to today's JSONL log. Use from pi templates so
# pi doesn't have to construct heredocs or worry about parens/quotes/newlines.
#
# Two usage modes:
#
# 1. Positional (react/queue tasks — fixed schema):
#      op-log <job> <target> <action> <reason> [outcome]
#    Example:
#      op-log react cf-openai/@cf/google/gemma-4-26b-a4b-it skip "daily-cap not past" "deferred"
#
# 2. Stdin JSON (health/patch tasks — flexible schema):
#      echo '{"job":"health","level":"green","demoted":3}' | op-log -
#    Reads ONE JSON object from stdin, injects ts if missing, validates,
#    appends as exactly one line with trailing newline.
#
# Both modes:
#  - JSON-escape via python3 json.dumps (so no parens/newlines break the line)
#  - Always end with newline (fixes the {...}{...} concat bug)
#  - Always write to ~/.coire/operator/logs/$(date -u +%Y-%m-%d).jsonl
#  - Print the canonical log path on stdout so callers can echo it in SUMMARY

set -euo pipefail

LOG_DIR="${LOG_DIR:-$HOME/.coire/operator/logs}"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/$(date -u +%Y-%m-%d).jsonl"
TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)

if [ $# -eq 1 ] && [ "$1" = "-" ]; then
  # Stdin JSON mode — keep heredoc OFF this branch (heredoc steals stdin).
  python3 -c '
import json, sys
ts, log_file = sys.argv[1], sys.argv[2]
data = json.loads(sys.stdin.read())
if not isinstance(data, dict):
    sys.exit("op-log: stdin must be JSON object")
data.setdefault("ts", ts)
with open(log_file, "a") as f:
    f.write(json.dumps(data) + "\n")
' "$TS" "$LOG_FILE"
elif [ $# -ge 4 ]; then
  # Positional mode (react)
  JOB="$1"; TARGET="$2"; ACTION="$3"; REASON="$4"; OUTCOME="${5:-}"
  python3 -c '
import json, sys
ts, log_file, job, target, action, reason, outcome = sys.argv[1:8]
with open(log_file, "a") as f:
    f.write(json.dumps({
        "ts": ts, "job": job, "target": target,
        "action": action, "reason": reason, "outcome": outcome,
    }) + "\n")
' "$TS" "$LOG_FILE" "$JOB" "$TARGET" "$ACTION" "$REASON" "$OUTCOME"
else
  echo "usage:" >&2
  echo "  op-log <job> <target> <action> <reason> [outcome]" >&2
  echo "  echo '<json>' | op-log -" >&2
  exit 64
fi

# Print canonical path so the caller's SUMMARY line can reference it.
echo "$LOG_FILE"
