[Unit]
Description=Auto-demote unhealthy primaries (err >5/hr OR p95 > 30s × 3 ticks)
After=network.target

[Service]
Type=oneshot
WorkingDirectory=%h/coire-ansic
ExecStart=/usr/bin/python3 %h/coire-ansic/scripts/runtime/auto_demote_unhealthy.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=300
Nice=15
