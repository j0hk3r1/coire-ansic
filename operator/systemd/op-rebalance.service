[Unit]
Description=Op rebalance — adaptive pool weights based on 24h utilization
After=network.target

[Service]
Type=oneshot
WorkingDirectory=%h/coire-ansic
ExecStart=/usr/bin/python3 %h/coire-ansic/scripts/runtime/auto_rebalance_weights.py
ExecStartPost=/usr/bin/python3 %h/coire-ansic/scripts/runtime/apply_pool_weights.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=120
Nice=10
