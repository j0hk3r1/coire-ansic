[Unit]
Description=Adaptive utilization rebalance — every 6h (01:30 UTC + 6h cycles)

[Timer]
# 01:30 + 6h cycles = 01:30, 07:30, 13:30, 19:30 UTC. Daily was too slow
# for capacity drift detection — a provider crossing 75% util at 02:00
# previously waited 24h before auto-rebalance. Every 6h closes that loop
# while still leaving enough room for utilization to be meaningful (the
# usage_estimates daemon tracks rolling 24h window).
OnCalendar=*-*-* 01:30:00 UTC
OnCalendar=*-*-* 07:30:00 UTC
OnCalendar=*-*-* 13:30:00 UTC
OnCalendar=*-*-* 19:30:00 UTC
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
