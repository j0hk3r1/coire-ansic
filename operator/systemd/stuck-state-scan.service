[Unit]
Description=Stuck-state scanner — detects CB ghosts, yaml/live drift, pool sum drift
After=network.target

[Service]
Type=oneshot
WorkingDirectory=%h/coire-ansic
ExecStart=/usr/bin/python3 %h/coire-ansic/scripts/runtime/stuck_state_scan.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=180
Nice=15
