{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "coire": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Coire (bifrost via strip-shim)",
      "options": {
        "baseURL": "http://localhost:4002/v1"
      },
      "models": {
        "omo-main": {
          "name": "omo-main"
        },
        "omo-utility": {
          "name": "omo-utility"
        },
        "omo-gemini": {
          "name": "omo-gemini"
        }
      }
    }
  },
  "mcp": {
    "searxng": {
      "type": "local",
      "command": ["npx", "-y", "mcp-searxng"],
      "enabled": true,
      "environment": {
        "SEARXNG_URL": "http://localhost:8891"
      }
    },
    "firecrawl": {
      "type": "local",
      "command": ["npx", "-y", "firecrawl-mcp"],
      "enabled": true,
      "environment": {
        "FIRECRAWL_API_URL": "http://localhost:3002"
      }
    }
  },
  "plugin": ["oh-my-openagent@latest"]
}
