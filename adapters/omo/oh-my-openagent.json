{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "_doc": "PROPOSED 2026-05-22: omo-kimi + omo-gpt-5-5 merged into omo-main (family-agnostic). Pool name no longer contains kimi/gpt-5-5 substring so omo loads buildDynamicSisyphusPrompt (default variant — adapts dynamically to whichever model bifrost serves, including auto gemini overrides when gemini fires). variant field still flows through as reasoning_effort. omo-utility + omo-gemini unchanged.",

  "runtime_fallback": false,

  "agents": {
    "sisyphus":          {"model": "coire/omo-main",    "variant": "medium"},
    "sisyphus-junior":   {"model": "coire/omo-main",    "variant": "medium"},
    "atlas":             {"model": "coire/omo-main",    "variant": "medium"},
    "metis":             {"model": "coire/omo-main",    "variant": "high"},
    "prometheus":        {"model": "coire/omo-main",    "variant": "high"},
    "hephaestus":        {"model": "coire/omo-main",    "variant": "medium"},
    "oracle":            {"model": "coire/omo-main",    "variant": "medium"},
    "momus":             {"model": "coire/omo-main",    "variant": "xhigh"},
    "librarian":         {"model": "coire/omo-utility"},
    "explore":           {"model": "coire/omo-utility"},
    "multimodal-looker": {"model": "coire/omo-gemini"}
  },

  "categories": {
    "visual-engineering": {"model": "coire/omo-gemini",  "variant": "high"},
    "artistry":           {"model": "coire/omo-gemini",  "variant": "xhigh"},
    "ultrabrain":         {"model": "coire/omo-main",    "variant": "xhigh"},
    "deep":               {"model": "coire/omo-main",    "variant": "medium"},
    "quick":              {"model": "coire/omo-utility"},
    "writing":            {"model": "coire/omo-main"},
    "unspecified-high":   {"model": "coire/omo-main",    "variant": "medium"},
    "unspecified-low":    {"model": "coire/omo-main",    "variant": "medium"}
  }
}
