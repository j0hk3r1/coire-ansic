#!/usr/bin/env bash
# coire-snapshot-sync — capture current bifrost config to repo + commit.
#
# Use after material changes to bifrost (provider added, pool edited,
# rule reordered). Diffs against repo snapshots; only commits if changed.
#
# Run on .93 (or wherever bifrost lives):
#   ~/coire-tools/coire-snapshot-sync           # capture + show diff
#   ~/coire-tools/coire-snapshot-sync --commit  # also git commit + (optional) push

set -u

COMMIT=0
for arg in "$@"; do
  case "$arg" in
    --commit) COMMIT=1 ;;
    -h|--help) grep '^#' "$0" | head -10 | sed 's/^# \?//' ; exit 0 ;;
  esac
done

REPO_DIR="${REPO_DIR:-$HOME/coire-ansic}"
if [ ! -d "$REPO_DIR/bifrost/snapshot" ]; then
  echo "✗ no repo at $REPO_DIR — set REPO_DIR env var"
  exit 1
fi

echo "# coire-snapshot-sync v0.1 — $(date -u +%H:%M:%S)Z"
echo

cd "$REPO_DIR"
python3 bifrost/snapshot.py 2>&1 | tail -10

echo
echo "## diff vs HEAD"
if git diff --quiet -- bifrost/snapshot/; then
  echo "  ✓ no changes — snapshot already in sync"
  exit 0
fi
git diff --stat -- bifrost/snapshot/
echo
git diff -- bifrost/snapshot/ | head -50

if [ "$COMMIT" -eq 1 ]; then
  echo
  echo "## committing"
  git add bifrost/snapshot/
  git commit -m "auto(snapshot): drift sync from live bifrost

Captured via coire-snapshot-sync skill.

🤖 Generated with [Claude Code](https://claude.com/claude-code)

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>"
  echo "  ✓ committed (local only — push manually if desired)"
else
  echo
  echo "## next step"
  echo "  Run with --commit to add + commit, OR review then commit manually:"
  echo "    git add bifrost/snapshot/ && git commit"
fi
